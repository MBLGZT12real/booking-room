# ============================================================
# BOOKING ROOM SYSTEM - Apache Configuration
# ============================================================

Options -Indexes
ServerSignature Off

# ---- Custom Error Pages ----
# Apache 2.4 <If> — deteksi otomatis berdasarkan host
<If "%{HTTP_HOST} == 'localhost'">
    ErrorDocument 403 /booking-room/403.php
</If>
<Else>
    ErrorDocument 403 /7booking-room/403.php
</Else>

# Enable URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# ---- Security Headers ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- PHP Settings (per-project, tidak ubah setting global XAMPP) ----
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
</IfModule>

# ---- Protect sensitive file types ----
<FilesMatch "\.(env|sql|log|ini|conf|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ---- Compression ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# ---- Cache Static Files ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ---- Default charset ----
AddDefaultCharset UTF-8
